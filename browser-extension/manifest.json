{
  "manifest_version": 3,
  "name": "Focus Blocker Companion",
  "version": "1.0.0",
  "description": "Enforces website and URL-path rules managed from Raycast. No browsing history is stored or transmitted.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "permissions": ["declarativeNetRequest", "webNavigation", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Focus Blocker",
    "default_icon": { "16": "icon16.png", "32": "icon32.png" },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "blocked.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
